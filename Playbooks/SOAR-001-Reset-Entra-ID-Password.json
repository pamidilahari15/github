{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "SOAR-001-Reset-Entra-ID-Password"
        },
        "SocMailbox": {
            "type": "string",
            "defaultValue": "soc-mailbox@example.invalid",
            "metadata": {
                "description": "Mailbox that receives the SOAR-001 outcome email."
            }
        },
        "SenderMailbox": {
            "type": "string",
            "defaultValue": "sentinel-notifications@example.invalid",
            "metadata": {
                "description": "Existing mailbox the playbook sends from using Microsoft Graph (Mail.Send)."
            }
        },
        "ExcludedUserPrincipalNames": {
            "type": "array",
            "defaultValue": [],
            "metadata": {
                "description": "Lowercase UPNs that must never be reset (break-glass and service accounts)."
            }
        }
    },
    "variables": {
        "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('AzureSentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('AzureSentinelConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
            ],
            "tags": {
                "SOAR-ID": "SOAR-001"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "socMailbox": {
                            "type": "String"
                        },
                        "senderMailbox": {
                            "type": "String"
                        },
                        "excludedUpns": {
                            "type": "Array"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Initialize_ActionLog": {
                            "type": "InitializeVariable",
                            "runAfter": {},
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "ActionLog",
                                        "type": "array",
                                        "value": []
                                    }
                                ]
                            }
                        },
                        "Entities_-_Get_Accounts": {
                            "type": "ApiConnection",
                            "runAfter": {
                                "Initialize_ActionLog": [
                                    "Succeeded"
                                ]
                            },
                            "inputs": {
                                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "path": "/entities/account"
                            }
                        },
                        "For_each_account": {
                            "type": "Foreach",
                            "foreach": "@body('Entities_-_Get_Accounts')?['Accounts']",
                            "runAfter": {
                                "Entities_-_Get_Accounts": [
                                    "Succeeded"
                                ]
                            },
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "repetitions": 1
                                }
                            },
                            "actions": {
                                "Compose_UserKey": {
                                    "type": "Compose",
                                    "runAfter": {},
                                    "inputs": "@if(empty(items('For_each_account')?['AadUserId']), concat(items('For_each_account')?['Name'], '@', items('For_each_account')?['UPNSuffix']), items('For_each_account')?['AadUserId'])"
                                },
                                "Process_Account": {
                                    "type": "Scope",
                                    "runAfter": {
                                        "Compose_UserKey": [
                                            "Succeeded"
                                        ]
                                    },
                                    "actions": {
                                        "Get_User": {
                                            "type": "Http",
                                            "runAfter": {},
                                            "inputs": {
                                                "method": "GET",
                                                "uri": "https://graph.microsoft.com/v1.0/users/@{encodeUriComponent(outputs('Compose_UserKey'))}?$select=id,userPrincipalName,accountEnabled,onPremisesSyncEnabled",
                                                "authentication": {
                                                    "type": "ManagedServiceIdentity",
                                                    "audience": "https://graph.microsoft.com"
                                                }
                                            }
                                        },
                                        "Get_Directory_Roles": {
                                            "type": "Http",
                                            "runAfter": {
                                                "Get_User": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "inputs": {
                                                "method": "GET",
                                                "uri": "https://graph.microsoft.com/v1.0/users/@{body('Get_User')?['id']}/memberOf/microsoft.graph.directoryRole?$select=displayName",
                                                "authentication": {
                                                    "type": "ManagedServiceIdentity",
                                                    "audience": "https://graph.microsoft.com"
                                                }
                                            }
                                        },
                                        "Is_Eligible_For_Reset": {
                                            "type": "If",
                                            "runAfter": {
                                                "Get_Directory_Roles": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "expression": {
                                                "and": [
                                                    {
                                                        "not": {
                                                            "equals": [
                                                                "@body('Get_User')?['onPremisesSyncEnabled']",
                                                                true
                                                            ]
                                                        }
                                                    },
                                                    {
                                                        "equals": [
                                                            "@body('Get_User')?['accountEnabled']",
                                                            true
                                                        ]
                                                    },
                                                    {
                                                        "equals": [
                                                            "@length(body('Get_Directory_Roles')?['value'])",
                                                            0
                                                        ]
                                                    },
                                                    {
                                                        "not": {
                                                            "contains": [
                                                                "@parameters('excludedUpns')",
                                                                "@toLower(body('Get_User')?['userPrincipalName'])"
                                                            ]
                                                        }
                                                    }
                                                ]
                                            },
                                            "actions": {
                                                "Reset_Password": {
                                                    "type": "Http",
                                                    "runAfter": {},
                                                    "runtimeConfiguration": {
                                                        "secureData": {
                                                            "properties": [
                                                                "inputs",
                                                                "outputs"
                                                            ]
                                                        }
                                                    },
                                                    "inputs": {
                                                        "method": "PATCH",
                                                        "uri": "https://graph.microsoft.com/v1.0/users/@{body('Get_User')?['id']}",
                                                        "body": {
                                                            "passwordProfile": {
                                                                "forceChangePasswordNextSignIn": true,
                                                                "password": "@{concat('Aa1!', toUpper(substring(replace(guid(), '-', ''), 0, 10)), substring(replace(guid(), '-', ''), 0, 12))}"
                                                            }
                                                        },
                                                        "authentication": {
                                                            "type": "ManagedServiceIdentity",
                                                            "audience": "https://graph.microsoft.com"
                                                        }
                                                    }
                                                },
                                                "Revoke_Sessions": {
                                                    "type": "Http",
                                                    "runAfter": {
                                                        "Reset_Password": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "inputs": {
                                                        "method": "POST",
                                                        "uri": "https://graph.microsoft.com/v1.0/users/@{body('Get_User')?['id']}/revokeSignInSessions",
                                                        "authentication": {
                                                            "type": "ManagedServiceIdentity",
                                                            "audience": "https://graph.microsoft.com"
                                                        }
                                                    }
                                                },
                                                "Add_Comment_Reset": {
                                                    "type": "ApiConnection",
                                                    "runAfter": {
                                                        "Revoke_Sessions": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "inputs": {
                                                        "body": {
                                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                                            "message": "<p>SOAR-001: Password reset (change required at next sign-in) and sign-in sessions revoked for @{body('Get_User')?['userPrincipalName']}.</p>"
                                                        },
                                                        "host": {
                                                            "connection": {
                                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                            }
                                                        },
                                                        "method": "post",
                                                        "path": "/Incidents/Comment"
                                                    }
                                                },
                                                "Append_Log_Reset": {
                                                    "type": "AppendToArrayVariable",
                                                    "runAfter": {
                                                        "Add_Comment_Reset": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "inputs": {
                                                        "name": "ActionLog",
                                                        "value": "@{body('Get_User')?['userPrincipalName']}: password reset and sessions revoked"
                                                    }
                                                }
                                            },
                                            "else": {
                                                "actions": {
                                                    "Add_Comment_Skipped": {
                                                        "type": "ApiConnection",
                                                        "runAfter": {},
                                                        "inputs": {
                                                            "body": {
                                                                "incidentArmId": "@triggerBody()?['object']?['id']",
                                                                "message": "<p>SOAR-001: No automated reset for @{body('Get_User')?['userPrincipalName']}. The account is synced from on-premises, disabled, holds a directory role, or is on the exclusion list. Manual remediation required.</p>"
                                                            },
                                                            "host": {
                                                                "connection": {
                                                                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                                }
                                                            },
                                                            "method": "post",
                                                            "path": "/Incidents/Comment"
                                                        }
                                                    },
                                                    "Append_Log_Skipped": {
                                                        "type": "AppendToArrayVariable",
                                                        "runAfter": {
                                                            "Add_Comment_Skipped": [
                                                                "Succeeded"
                                                            ]
                                                        },
                                                        "inputs": {
                                                            "name": "ActionLog",
                                                            "value": "@{body('Get_User')?['userPrincipalName']}: skipped (synced, disabled, privileged or excluded) - manual action required"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "Handle_Failure": {
                                    "type": "Scope",
                                    "runAfter": {
                                        "Process_Account": [
                                            "Failed",
                                            "TimedOut"
                                        ]
                                    },
                                    "actions": {
                                        "Add_Comment_Failure": {
                                            "type": "ApiConnection",
                                            "runAfter": {},
                                            "inputs": {
                                                "body": {
                                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                                    "message": "<p>SOAR-001: Automated remediation failed for account @{outputs('Compose_UserKey')}. Check the Logic App run history and remediate manually.</p>"
                                                },
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "path": "/Incidents/Comment"
                                            }
                                        },
                                        "Append_Log_Failure": {
                                            "type": "AppendToArrayVariable",
                                            "runAfter": {
                                                "Add_Comment_Failure": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "inputs": {
                                                "name": "ActionLog",
                                                "value": "@{outputs('Compose_UserKey')}: automation FAILED - manual action required"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Send_SOC_Email": {
                            "type": "Http",
                            "runAfter": {
                                "For_each_account": [
                                    "Succeeded",
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "inputs": {
                                "method": "POST",
                                "uri": "https://graph.microsoft.com/v1.0/users/@{encodeUriComponent(parameters('senderMailbox'))}/sendMail",
                                "body": {
                                    "message": {
                                        "subject": "[SOAR-001] Entra ID high-risk user response: @{triggerBody()?['object']?['properties']?['title']}",
                                        "body": {
                                            "contentType": "HTML",
                                            "content": "<p>Incident: @{triggerBody()?['object']?['properties']?['title']}</p><p><a href=\"@{triggerBody()?['object']?['properties']?['incidentUrl']}\">Open incident</a></p><p>@{if(empty(variables('ActionLog')), 'No account entities were found on this incident.', join(variables('ActionLog'), '<br/>'))}</p>"
                                        },
                                        "toRecipients": [
                                            {
                                                "emailAddress": {
                                                    "address": "@parameters('socMailbox')"
                                                }
                                            }
                                        ]
                                    },
                                    "saveToSentItems": false
                                },
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://graph.microsoft.com"
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                                "connectionName": "[variables('AzureSentinelConnectionName')]",
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    },
                    "socMailbox": {
                        "value": "[parameters('SocMailbox')]"
                    },
                    "senderMailbox": {
                        "value": "[parameters('SenderMailbox')]"
                    },
                    "excludedUpns": {
                        "value": "[parameters('ExcludedUserPrincipalNames')]"
                    }
                }
            }
        }
    ],
    "outputs": {
        "playbookPrincipalId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
        }
    }
}
