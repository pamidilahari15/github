{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "string"
        },
        "ruleEnabled": {
            "type": "bool",
            "defaultValue": true
        }
    },
    "resources": [
        {
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "apiVersion": "2022-04-01-preview",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/3f6c1a52-8d7e-4b0a-9c41-2e5a7b9d0c01')]",
            "kind": "Scheduled",
            "properties": {
                "displayName": "UC-001 - Identity - Password spray against Entra ID",
                "description": "Detects a single source IP with invalid-password failures (ResultType 50126) against at least 5 distinct accounts within 20 minutes in Entra ID interactive sign-in logs.",
                "severity": "Medium",
                "enabled": "[parameters('ruleEnabled')]",
                "query": "let MinimumAccounts = 5;\nSigninLogs\n| where TimeGenerated >= ago(20m)\n| where tostring(ResultType) == \"50126\"\n| where isnotempty(IPAddress) and isnotempty(UserPrincipalName)\n| extend Account = tolower(UserPrincipalName)\n| summarize AccountFailures = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by IPAddress, Account\n| summarize DistinctAccounts = count(), FailedAttempts = sum(AccountFailures), TargetAccounts = make_set(Account, 100), StartTime = min(FirstSeen), EndTime = max(LastSeen) by IPAddress\n| where DistinctAccounts >= MinimumAccounts\n| extend TimeGenerated = EndTime\n| project TimeGenerated, IPAddress, DistinctAccounts, FailedAttempts, TargetAccounts, StartTime, EndTime",
                "queryFrequency": "PT5M",
                "queryPeriod": "PT20M",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionEnabled": false,
                "suppressionDuration": "PT1H",
                "tactics": [
                    "CredentialAccess"
                ],
                "techniques": [
                    "T1110"
                ],
                "entityMappings": [
                    {
                        "entityType": "IP",
                        "fieldMappings": [
                            {
                                "identifier": "Address",
                                "columnName": "IPAddress"
                            }
                        ]
                    }
                ],
                "customDetails": {
                    "DistinctAccounts": "DistinctAccounts",
                    "FailedAttempts": "FailedAttempts",
                    "TargetAccounts": "TargetAccounts"
                },
                "eventGroupingSettings": {
                    "aggregationKind": "AlertPerResult"
                },
                "incidentConfiguration": {
                    "createIncident": true,
                    "groupingConfiguration": {
                        "enabled": true,
                        "reopenClosedIncident": false,
                        "lookbackDuration": "PT1H",
                        "matchingMethod": "Selected",
                        "groupByEntities": [
                            "IP"
                        ],
                        "groupByAlertDetails": [],
                        "groupByCustomDetails": []
                    }
                }
            }
        }
    ]
}
